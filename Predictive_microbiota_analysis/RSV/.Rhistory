roc_obj <- roc(y, probs)
# Punto óptimo (Youden)
coords_opt <- coords(roc_obj, "best", ret=c("threshold","sensitivity","specificity"), best.method="youden")
png("ROC_curve_Firth.png", width=800, height=800)
plot(roc_obj, main=paste0("ROC Curve (AUC = ", round(auc(roc_obj),3), ")"),
col="blue", lwd=2)  # pROC dibuja X=1-spec, Y=sens automáticamente
