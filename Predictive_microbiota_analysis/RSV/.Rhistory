AUC = auc(roc_obj),
Threshold_opt = coords_opt["threshold"],
Sensitivity_opt = coords_opt["sensitivity"],
Specificity_opt = coords_opt["specificity"]
)
write.csv(roc_metrics, "ROC_metrics.csv", row.names=FALSE)
# ========================================
# FIN DEL SCRIPT
